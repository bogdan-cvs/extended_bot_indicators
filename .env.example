# =============================================================================
# Extended Exchange MM Bot - Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your credentials
#            NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# API CREDENTIALS (REQUIRED)
# =============================================================================

# API Key from Extended Exchange
# How to get: Extended Exchange dashboard -> API Keys -> Create New Key
# Required permissions: Read, Trade (not Withdraw)
EXTENDED_API_KEY=16d6b2d3a2675c46a8d953c5f09f41f6

# Stark Private Key for signing orders
# This is your account's Stark private key (hex format, with or without 0x prefix)
# How to get: Export from your wallet or Extended Exchange account settings
# ⚠️  KEEP THIS SECRET - never share or commit!
EXTENDED_STARK_PRIVATE_KEY=0x74f2db97bd2e3daba7d9560f996db548a9d1b2052290e0fe6620f8622e72ca3

# Account Address (Stark contract address)
# Your account's Stark contract address on StarkNet
EXTENDED_ACCOUNT_ADDRESS=0x2c54eafb8ba67b1d0842802f7b72662891d71443208e8c1673e93d2ec1a752a

# =============================================================================
# OPTIONAL: VAULT/SUB-ACCOUNT (if applicable)
# =============================================================================

# Vault ID (if using sub-accounts)
# Leave empty if not using vaults
EXTENDED_VAULT_ID=506189

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================

# Default environment: testnet or mainnet
# Can be overridden with --env CLI flag
BOT_ENV=testnet

# Default profile name
# Can be overridden with --profile CLI flag
BOT_PROFILE=TESTNET_SAFE

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (optional, logs to stdout if not set)
LOG_FILE=

# Enable JSON logging (true/false)
JSON_LOGS=true

# Metrics export interval (seconds)
METRICS_INTERVAL_SEC=60

# =============================================================================
# ADVANCED CONFIGURATION (usually not needed)
# =============================================================================

# Custom REST API base URL (override default for env)
# EXTENDED_REST_URL=

# Custom WebSocket URL (override default for env)
# EXTENDED_WS_URL=

# HTTP request timeout (seconds)
HTTP_TIMEOUT_SEC=30

# WebSocket reconnect delay (seconds)
WS_RECONNECT_DELAY_SEC=5

# Max WebSocket reconnect attempts before giving up
WS_MAX_RECONNECT_ATTEMPTS=10

# =============================================================================
# STOP-LOSS CONFIGURATION
# =============================================================================

# Stop-loss percentage (triggers market order to close position)
# Set to 0 to disable stop-loss
# Example: 5.0 means close position if unrealized loss exceeds 5% of position value
STOP_LOSS_PCT=5.0

# =============================================================================
# SAFETY OVERRIDES (USE WITH CAUTION)
# =============================================================================

# Force dry run mode regardless of config
# Useful for testing configs without placing orders
# FORCE_DRY_RUN=true

# Disable kill switch (NOT RECOMMENDED)
# DISABLE_KILL_SWITCH=false

# =============================================================================
# HOW TO USE
# =============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with your credentials:
#    nano .env
#
# 3. Verify .env is in .gitignore:
#    echo ".env" >> .gitignore
#
# 4. Test connection:
#    python -m src.main --env testnet --check-only
#
# 5. Run in dry mode first:
#    python -m src.main --env testnet --profile TESTNET_SAFE --dry-run
#
# 6. Go live on testnet:
#    python -m src.main --env testnet --profile TESTNET_SAFE
# =============================================================================
